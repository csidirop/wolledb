{
    "name": "schlossbewohnerinnen/wolledb",
    "description": "Wool database for TYPO3",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "wool"
    ],
    "authors": [
        {
            "name": "Christos"
        },
        {
            "name": "Selina"
        }
    ],
    "autoload": {
        "psr-4": {
            "SBW\\WDB\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SBW\\WDB\\Tests\\": "Tests/"
        }
    },
    "require-dev": {
        "typo3/testing-framework": "^9.0"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "wdb"
        }
    }
}
